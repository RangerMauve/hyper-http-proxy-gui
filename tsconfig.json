{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "checkJs": true,
    "allowJs": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "useUnknownInCatchVariables":false
  },
  "include": ["src/**/*.js", "types/**/*.d.ts", "test/**/*.js"],
  "exclude": ["node_modules", "dist"]
}
